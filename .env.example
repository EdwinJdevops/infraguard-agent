INFRAGUARD_API_KEY=replace-with-at-least-32-random-characters
INFRAGUARD_TERRAFORM_ROOT=/absolute/path/to/trusted/terraform
# Optional. Terraform state is sensitive and must be mounted read-only.
# INFRAGUARD_TERRAFORM_STATE_PATH=/absolute/path/to/terraform.tfstate
INFRAGUARD_ALLOWED_SSH_CIDRS=10.20.30.40/32,fd00:1234::/64
INFRAGUARD_ENVIRONMENT=development
INFRAGUARD_DOCS_ENABLED=false
